rules_version = '2';

/**
 * Firestore Security Rules - ClubSportFrance
 *
 * Patterns appliques:
 * - users: Public visible (lecture: tous, modification: owner)
 * - clubs: Contributif libre (lecture: tous, creation: auth, modification: createur)
 * - favorites: Prive (lecture/ecriture: owner uniquement)
 * - searches: Prive (lecture/ecriture: owner uniquement)
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // Fonction helper: utilisateur authentifie
    function isSignedIn() {
      return request.auth != null;
    }

    // Fonction helper: utilisateur est proprietaire
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Fonction helper: utilisateur est createur du document
    function isCreator() {
      return request.auth.uid == resource.data.createdBy;
    }

    // ===========================================
    // COLLECTION: users/
    // Pattern: Public visible
    // ===========================================
    match /users/{userId} {
      // Lecture: Tous les utilisateurs authentifies
      allow read: if isSignedIn();

      // Creation: Lors de l'inscription (uid doit correspondre)
      allow create: if isSignedIn()
                    && isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.role in ['user', 'club'];

      // Modification: Proprietaire uniquement
      // Ne peut pas modifier: uid, email, role, createdAt
      allow update: if isSignedIn()
                    && isOwner(userId)
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.createdAt == resource.data.createdAt;

      // Suppression: Proprietaire uniquement
      allow delete: if isSignedIn() && isOwner(userId);
    }

    // ===========================================
    // COLLECTION: clubs/
    // Pattern: Contributif libre
    // ===========================================
    match /clubs/{clubId} {
      // Lecture: Tous (meme non authentifies pour SEO web)
      allow read: if true;

      // Creation: Utilisateurs authentifies
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasAll(['name', 'sport', 'city', 'createdBy', 'createdAt'])
                    && request.resource.data.createdBy == request.auth.uid;

      // Modification: Createur uniquement
      allow update: if isSignedIn()
                    && isCreator()
                    && request.resource.data.createdBy == resource.data.createdBy; // createdBy ne peut pas changer

      // Suppression: Createur uniquement
      allow delete: if isSignedIn() && isCreator();
    }

    // ===========================================
    // COLLECTION: favorites/
    // Pattern: Prive (owner only)
    // ===========================================
    match /favorites/{favoriteId} {
      // Lecture: Proprietaire uniquement
      allow read: if isSignedIn() && isOwner(resource.data.userId);

      // Creation: Utilisateur authentifie (devient proprietaire)
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.keys().hasAll(['userId', 'clubId', 'createdAt']);

      // Modification: Interdite (on supprime et recree)
      allow update: if false;

      // Suppression: Proprietaire uniquement
      allow delete: if isSignedIn() && isOwner(resource.data.userId);
    }

    // ===========================================
    // COLLECTION: searches/
    // Pattern: Prive (owner only - RGPD)
    // ===========================================
    match /searches/{searchId} {
      // Lecture: Proprietaire uniquement
      allow read: if isSignedIn() && isOwner(resource.data.userId);

      // Creation: Utilisateur authentifie (devient proprietaire)
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.keys().hasAll(['userId', 'query', 'createdAt']);

      // Modification: Interdite
      allow update: if false;

      // Suppression: Proprietaire uniquement
      allow delete: if isSignedIn() && isOwner(resource.data.userId);
    }
  }
}
